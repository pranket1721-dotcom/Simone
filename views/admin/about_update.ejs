<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Update About record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>About form</h3>

            <form class="form" action="/admin/about_update_save/<%=data.aid%>" method="post" >
              <div class="row">
                <div class="field">
                  <label for="img">About Title</label>
                  <input id="img" type="text" value="<%=data.a_title%>" name="a_title"/>
                </div>
                <div class="field">
                  <label for="text">Description</label>
                  <input id="text" type="text" value="<%=data.a_desc%>" name="a_desc" placeholder="title......" />
                </div>
                 <div class="field">
                  <label for="text">About Name</label>
                  <input id="text" type="text" value="<%=data.a_name%>" name="a_name" placeholder="title......" />
                </div>
                 <div class="field">
                  <label for="text">Email</label>
                  <input id="text" type="text" value="<%=data.a_email%>" name="a_email" placeholder="title......" />
                </div>

                 <div class="field">
                  <label for="text">About Age</label>
                  <input id="text" type="text" value="<%=data.a_age%>" name="a_age" placeholder="title......" />
                </div> 

                <div class="field">
                  <label for="text">About address</label>
                  <input id="text" type="text" value="<%=data.a_address%>" name="a_address" placeholder="title......" />
                </div>
                
                <div class="field">
                  <label for="text">Resume</label>
                  <input id="text" type="text" value="<%=data.a_resume%>" name="a_resume" placeholder="title......" />
                </div>
                
                <div class="field">
                  <label for="text">About Pdf</label>
                  <input id="text" type="text" value="<%=data.a_pdf%>" name="a_pdf" placeholder="title......" />
                </div>
                
                <div class="field">
                  <label for="text">Count Experience</label>
                  <input id="text" type="text" value="<%=data.a_count_experience%>" name="a_count_experience" placeholder="title......" />
                </div> 
                
                <div class="field">
                  <label for="text">Count Project</label>
                  <input id="text" type="text" value="<%=data.a_count_project%>" name="a_count_project" placeholder="title......" />
                </div>

                   <div class="field">
                  <label for="text">Count Clients</label>
                  <input id="text" type="text" value="<%=data.a_count_clients%>" name="a_count_clients" placeholder="title......" />
                </div>

                   <div class="field">
                  <label for="text">Count Awards</label>
                  <input id="text" type="text" value="<%=data.a_count_awards%>" name="a_count_awards" placeholder="title......" />
                </div>
              </div>

            

            
              <div class="actions">
                <button class="btn" type="submit">Update</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>