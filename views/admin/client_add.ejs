<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Add Client record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Client form</h3>

            <form class="form" action="/admin/client_save" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="name">Client Message </label>
                  <input id="name" type="text" name="c_msg"/>
                </div>
                <div class="field">
                  <label for="img"> Client Photo</label>
                  <input id="img" type="file" name="c_img"  />
                </div>
              </div>

            

              <div class="field">
                <label for="notes">Client Name</label>
                <input name="c_name" id="name" >

              <div class="field">
                <label for="notes"> Client Position</label>
                <textarea id="notes" name="c_position"></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>