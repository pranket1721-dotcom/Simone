<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Users table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All users</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th> Client Message</th>
                  <th>Client Photo</th>
                  <th>Client Name</th>
                  <th>Client Position</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<client.length;i++){%>
                <tr>
                  <td><%= i+1%></td>
                  <td><%=client[i].c_msg%></td>
                  <td>
                    <img src="/img/<%=client[i].c_img%>" height="100px">
                  </td>
                  <td><%=client[i].c_name%></td>
                  <td><%=client[i].c_position%></td>
                  <td>
                        <span class="badge badge-ok">
                             <a href="/admin/delete/<%= client[i].cid %>">Delete</a>
                        </span>
                    <span class="badge badge-ok">Edit</span>
                </td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%-include('footer.ejs');%>