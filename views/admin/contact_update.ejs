<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2> Update contact record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Contact form</h3>

            <form class="form" action="/admin/contact_update_save/<%=data.id%>" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="text">Contact Address</label>
                  <input id="text" type="text"  value="<%=data.address%>" name="address"/>
                </div>
                <div class="field">
                  <label for="text">Contact Mobile</label>
                  <input id="text" type="text" value="<%=data.mobile%>" name="mobile"/>
                </div>
                 <div class="field">
                  <label for="text">Contact Email </label>
                  <input id="text" type="text" value="<%=data.email%>" name="email"  />
                </div>
                <div class="field">
                  <label for="text">Contact Symbol </label>
                  <input id="text" type="text" value="<%=data.symbol%>" name="symbol"  />
                </div>
                 
              </div>
              <div class="actions">
                <button class="btn" type="submit">Update</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>