<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Education table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All Educations</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Education Year </th>
                  <th>Education Degree</th>
                  <th>Education University</th>
                  <th>Education Description</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<education.length;i++){%>
                <tr>
                  <td><%= i+1%></td>
                  <td><%=education[i].e_year%></td>
                  <td><%=education[i].e_degree%></td>
                  <td><%=education[i].e_university%></td>
                  <td><%=education[i].e_desc%></td>
                     <td>
                    <span class="badge badge-ok">     
                                     <a href="/admin/education_delete/<%= education[i].eid %>">
                                      Delete</a></span>
                    <span class="badge badge-ok">Edit</span>
                </td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%-include('footer.ejs');%>