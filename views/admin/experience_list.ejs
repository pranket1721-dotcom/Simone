<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Experience table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All Experience</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Experience Year </th>
                  <th>Experience Position</th>
                  <th>Experience Company</th>
                  <th>Experience Description</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<experience.length;i++){%>
                <tr>
                  <td><%= i+1%></td>
                  <td><%=experience[i].e_year%></td>
                  <td><%=experience[i].e_position%></td>
                  <td><%=experience[i].e_company%></td>
                  <td><%=experience[i].e_desc%></td>
                     <td>
                   <span class="badge badge-ok">
                    <a href="/admin/experience_delete/<%= experience[i].eid %>">Delete</a>
                    </span>
                    <span class="badge badge-ok">Edit</span>
                </td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%-include('footer.ejs');%>