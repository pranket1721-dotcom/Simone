<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Add record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Edit Form</h3>
            <p class="hint">Static template only. Submit stays on this page.</p>

            <form class="form" action="/admin/service_update/<%= data.sid %>" method="POST">
              <div class="row">
                <div class="field">
                  <label for="name">Icons</label>
                  <input id="name" type="text" placeholder="fa fa-icons" />
                </div>
                <div class="field">
                  <label for="text">Title</label>
                  <input id="text" type="text" placeholder="title...." />
                </div>
              </div>

             

              <div class="field">
                <label for="notes">Notes</label>
                <textarea id="notes" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>